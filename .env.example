# PulseMatrix AI - Environment Configuration

# Server Settings
PORT=8080
BASE_CURRENCY=USD

# Security
JWT_SECRET=pulsematrix-super-secret-jwt-key-change-in-production-2026

# Database
DB_PATH=./data/pulsematrix.db

# API Keys (Optional - Free Tiers Available)
# 1. Google Gemini 1.5 API Key (Get free key at https://aistudio.google.com/)
GEMINI_API_KEY=

# 2. ExchangeRate API Key (Get free key at https://www.exchangerate-api.com/)
EXCHANGERATE_API_KEY=

# Feature Toggles
ENABLE_AI_SERVICES=true
